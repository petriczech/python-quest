{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist/python-quest/browser",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/@(index.html|ngsw.json|ngsw-worker.js|manifest.webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*-+([A-Za-z0-9]).@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9101 },
    "firestore": { "host": "127.0.0.1", "port": 8091 },
    "hub": { "host": "127.0.0.1", "port": 4408 },
    "logging": { "host": "127.0.0.1", "port": 4508 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
